(load "../carp-transform/transform.carp")
(load "../carp-dynamics/dynamics.carp")
(load "../carp-collision/collision.carp")
(load "Vector.carp")

(use Vector3)
(use Double)
(use Transform)
(use Body)
(use Collision)

(defmodule Solver
  (doc solve! "resolves a collision between two bodies by applying impulses and positional correction.
Uses a proper Coulomb friction model and Baumgarte stabilization.")
  (defn solve! [t-a b-a t-b b-b col]
    (let [contact (Collision.contact col)
          normal (Contact.normal contact)
          depth @(Contact.depth contact)
          
          inv-m-a @(Body.inv-mass b-a)
          inv-m-b @(Body.inv-mass b-b)
          total-inv-mass (+ inv-m-a inv-m-b)]
      (if (<= total-inv-mass 0.0)
          () ;; Both are static/kinematic
          (let [v-a (Body.velocity b-a)
                v-b (Body.velocity b-b)
                rel-v (Vector3.sub v-b v-a)
                vel-along-normal (Vector3.dot &rel-v normal)]
            (do
              ;; 1. Normal Impulse (J)
              (if (< vel-along-normal 0.0)
                  (let [e (min @(Body.restitution b-a) @(Body.restitution b-b))
                        j-num (- 0.0 (* (+ 1.0 e) vel-along-normal))
                        j (/ j-num total-inv-mass)
                        n-impulse (Vector3.mul normal j)]
                    (do
                      (Body.apply-impulse! b-a &(Vector3.mul &n-impulse -1.0))
                      (Body.apply-impulse! b-b &n-impulse)
                      
                      ;; 2. Tangent Impulse (Friction) via Coulomb's Law
                      (let [v-a2 (Body.velocity b-a)
                            v-b2 (Body.velocity b-b)
                            rel-v2 (Vector3.sub v-b2 v-a2)
                            v-n2 (Vector3.mul normal (Vector3.dot &rel-v2 normal))
                            v-tan (Vector3.sub &rel-v2 &v-n2)]
                        (if (> (Vector3.mag-sq &v-tan) 0.0001)
                            (let [t-norm (Vector3.normalize &v-tan)
                                  f-mu (min @(Body.friction b-a) @(Body.friction b-b))
                                  jt-num (- 0.0 (Vector3.dot &rel-v2 &t-norm))
                                  jt (/ jt-num total-inv-mass)
                                  ;; Clamp friction to Coulomb limit: abs(jt) <= j * mu
                                  max-f (* j f-mu)
                                  jt-clamped (Double.clamp (- 0.0 max-f) max-f jt)
                                  f-impulse (Vector3.mul &t-norm jt-clamped)]
                              (do
                                (Body.apply-impulse! b-a &(Vector3.mul &f-impulse -1.0))
                                (Body.apply-impulse! b-b &f-impulse)))
                            ()))))
                  ())

              ;; 3. Positional Correction
              (let [percent 0.4 
                    slop 0.01
                    corr-mag (* (/ (max (- depth slop) 0.0) total-inv-mass) percent)
                    correction (Vector3.mul normal corr-mag)]
                (do
                  (Transform.set-position! t-a (Vector3.sub (Transform.position t-a) &(Vector3.mul &correction inv-m-a)))
                  (Transform.set-position! t-b (Vector3.add (Transform.position t-b) &(Vector3.mul &correction inv-m-b))))))))))
)
